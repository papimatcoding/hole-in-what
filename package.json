{
  "name": "troll-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:hole": "tsx scripts/holePhysicsCheck.ts",
    "test:mechanics": "tsx scripts/mechanicIntegrityCheck.ts",
    "test:mechanic-behavior": "tsx scripts/mechanicBehaviorCheck.ts",
    "test:geometry": "tsx scripts/courseGeometryCheck.ts",
    "test:clearance": "tsx scripts/courseClearanceCheck.ts",
    "audit:courses": "tsx scripts/courseAudit.ts",
    "audit:originality": "tsx scripts/courseOriginalityAudit.ts",
    "audit:human": "tsx scripts/audit2.ts",
    "audit:human:full": "AUDIT2_MODE=full tsx scripts/audit2.ts",
    "audit:human:strict": "AUDIT2_MODE=full AUDIT2_STRICT=1 tsx scripts/audit2.ts",
    "audit:design": "tsx scripts/audit2Design.ts",
    "audit:v3": "tsx scripts/audit3.ts && tsx scripts/audit3LookAhead.ts",
    "audit:v3:full": "AUDIT3_MODE=full tsx scripts/audit3.ts && tsx scripts/audit3LookAhead.ts",
    "audit:v3:strict": "AUDIT3_MODE=full AUDIT3_STRICT=1 tsx scripts/audit3.ts && tsx scripts/audit3LookAhead.ts",
    "audit:v3:standalone": "npm run audit:human:full && npm run audit:v3:full"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
